# --- Generación de contenido con LLM (opcional: sin esto usa data/seed_facts.json) ---
OPENAI_API_KEY=
# Cualquier endpoint compatible con la API de chat de OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# --- Publicación automática vía Instagram Graph API (opcional) ---
# Requiere cuenta Business/Creator vinculada a una página de Facebook.
IG_USER_ID=
IG_ACCESS_TOKEN=
# URL pública donde subís las imágenes de out/ (S3, GitHub Pages, etc.)
IMAGE_HOSTING_URL=
